{
  "info": {
    "name": "CPRS API - Contract Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Verifies status codes, response structures and RFC 7807 error bodies against openapi/openapi.json"
  },
  "item": [
    {
      "name": "POST /reports - valid (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Content-Type is application/json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('Body matches the Report schema', () => pm.response.to.have.jsonSchema({\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"id\",\"category\",\"title\",\"description\",\"building\",\"location\",\"status\",\"createdAt\",\"updatedAt\"],\"properties\":{\"id\":{\"type\":\"string\"},\"category\":{\"enum\":[\"electrical\",\"plumbing\",\"security\",\"furniture\",\"lighting\",\"ict\",\"sanitation\",\"other\"]},\"title\":{\"type\":\"string\",\"minLength\":5,\"maxLength\":100},\"description\":{\"type\":\"string\",\"minLength\":10,\"maxLength\":1000},\"building\":{\"type\":\"string\",\"minLength\":2,\"maxLength\":60},\"location\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":60},\"status\":{\"enum\":[\"submitted\",\"in_review\",\"assigned\",\"in_progress\",\"resolved\"]},\"statusNote\":{\"type\":\"string\"},\"createdAt\":{\"type\":\"string\"},\"updatedAt\":{\"type\":\"string\"}}}));",
              "pm.test('New report starts as \"submitted\"', () => pm.expect(pm.response.json().status).to.eql('submitted'));",
              "pm.test('Location header points to the new report', () => pm.expect(pm.response.headers.get('Location')).to.eql('/api/v1/reports/' + pm.response.json().id));",
              "pm.collectionVariables.set('reportId', pm.response.json().id);",
              "pm.test('Rate-limit headers are present (documented in OpenAPI)', () => {",
              "  pm.response.to.have.header('RateLimit-Limit');",
              "  pm.response.to.have.header('RateLimit-Remaining');",
              "  pm.response.to.have.header('RateLimit-Reset');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"electrical\",\n  \"title\": \"Broken socket near the window\",\n  \"description\": \"The double socket next to the window has no power.\",\n  \"building\": \"Block A\",\n  \"location\": \"Room 12\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/reports",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "reports"
          ]
        }
      }
    },
    {
      "name": "POST /reports - missing required fields (422)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 422', () => pm.response.to.have.status(422));",
              "pm.test('Content-Type is application/problem+json (RFC 7807)', () => {",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
              "});",
              "pm.test('Body matches the Problem schema and status field equals 422', () => {",
              "  const body = pm.response.json();",
              "  pm.response.to.have.jsonSchema({\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"type\",\"title\",\"status\"],\"properties\":{\"type\":{\"type\":\"string\"},\"title\":{\"type\":\"string\"},\"status\":{\"type\":\"integer\",\"minimum\":400,\"maximum\":599},\"detail\":{\"type\":\"string\"},\"instance\":{\"type\":\"string\"},\"errors\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[\"in\",\"field\",\"message\"],\"properties\":{\"in\":{\"enum\":[\"body\",\"query\",\"path\"]},\"field\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"},\"keyword\":{\"type\":\"string\"}}}}}});",
              "  pm.expect(body.status).to.eql(422);",
              "});",
              "pm.test('Rate-limit headers are present (documented in OpenAPI)', () => {",
              "  pm.response.to.have.header('RateLimit-Limit');",
              "  pm.response.to.have.header('RateLimit-Remaining');",
              "  pm.response.to.have.header('RateLimit-Reset');",
              "});",
              "pm.test('errors[] lists each missing field', () => {",
              "  const fields = pm.response.json().errors.map(e => e.field);",
              "  pm.expect(fields).to.include.members(['/title', '/description', '/building', '/location']);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
